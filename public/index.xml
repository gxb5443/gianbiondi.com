      <pubDate>Mon, 01 Jan 2024 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/home/home/</guid>
      <description>&lt;section  id=&#34;showcase&#34; class=&#34;rad-showcase rad-showcase--index rad-animation-group rad-fade-down&#34;&gt;&#xA;  &lt;div&gt;&#xA;      &#xA;&#xA;    &lt;div class=&#34;showcase-section row flex-column-reverse flex-md-row rad-fade-down rad-waiting rad-animate&#34;&gt;&#xA;      &lt;div class=&#34;col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6&#34;&gt;&#xA;        &lt;h1 class=&#34;display-1&#34;&gt;&#xA;          Hello, I&amp;#39;m Gian!&#xA;        &lt;/h1&gt;&#xA;        &lt;h2 class=&#34;display-5&#34;&gt;&#xA;          &lt;span&gt;Engineering Leader in Software and Technology&lt;/span&gt;&#xA;        &lt;/h2&gt;&#xA;        &lt;div class=&#34;lead&#34;&gt;&#xA;          Based in the New York City area, I am a Principal Engineer for Walmart Health and Wellness. I am a passionate and experienced engineer and leader, with a thorough background as a computer engineer and scientist, and experience as an individual contributor and team/project lead.&#xA;        &lt;/div&gt;&#xA;        &#xA;        &lt;a&#xA;          href=&#34;me@gianbiondi.com&#34;&#xA;          class=&#34;btn btn-primary&#34;&#xA;        &gt;&#xA;          &lt;i class=&#34;icon-email&#34;&gt;&lt;/i&gt;&#xA;          Contact Me&#xA;        &lt;/a&gt;&#xA;        &#xA;      &lt;/div&gt;&#xA;      &lt;div class=&#34;col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6 profile-image&#34;&gt;&#xA;        &#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;        &#xA;        &#xA;&#xA;&#xA;&#xA;    &#xA;    &#xA;&#xA;&#xA;    &lt;picture class=&#34;&#34;&gt;&#xA;            &#xA;            &#xA;&#xA;            &lt;source srcset=&#34;http://localhost:1313/images/gian_hu_764ac5e8bd8e6624.webp 1x, http://localhost:1313/images/gian_hu_125337ad1b68f47a.webp 2x&#34; type=&#34;image/webp&#34; /&gt;&#xA;            &lt;source srcset=&#34;http://localhost:1313/images/gian_hu_5b70ce6e5b397659.jpg 1x, http://localhost:1313/images/gian_hu_df4152914d63e106.jpg 2x&#34; type=&#34;image/jpeg&#34;&gt;&#xA;&#xA;        &lt;img&#xA;                width=&#34;400&#34;&#xA;                height=&#34;400&#34;&#xA;                class=&#34;lozad img-responsive &#34;&#xA;                data-src=&#34;http://localhost:1313/images/gian_hu_5b70ce6e5b397659.jpg&#34;&#xA;                alt=&#39;&#39;&#xA;                src=&#34;data:image/gif;base64,R0lGODlhBwACAIAAAP///wAAACH5BAEAAAEALAAAAAAHAAIAAAIDjI9YADs=&#34;&#xA;                loading=&#34;lazy&#34;&#xA;                decoding=&#34;async&#34;&#xA;        /&gt;&#xA;    &lt;/picture&gt;&#xA;&#xA;&#xA;&#xA;&#xA;      &lt;/div&gt;&#xA;    &lt;div class=&#34;col-12 inner-content&#34;&gt;&#xA;      &#xA;&#xA;    &#xA;&#xA;&#xA;&#xA;&lt;div class=&#34;container&#34;&gt;&#xA;  &lt;div class=&#34;row platform-links shortcode&#34;&gt;&#xA;    &lt;div class=&#34;col-12&#34;&gt;&#xA;        &#xA;         &#xA;        &lt;a&#xA;          href=&#34;https://www.linkedin.com/in/gianfranco-biondi/&#34;&#xA;          target=&#34;_blank&#34;&#xA;          rel=&#34;noopener noreferrer&#34;&#xA;          aria-label=&#34;linkedin&#34;&#xA;          &gt;&lt;i class=&#34;icon-linkedin&#34;&gt;&lt;/i&gt;&#xA;        &lt;/a&gt;&#xA;&#xA;        &#xA;         &#xA;        &lt;a&#xA;          href=&#34;https://github.com/gxb5443&#34;&#xA;          target=&#34;_blank&#34;&#xA;          rel=&#34;noopener noreferrer&#34;&#xA;          aria-label=&#34;square-github&#34;&#xA;          &gt;&lt;i class=&#34;icon-square-github&#34;&gt;&lt;/i&gt;&#xA;        &lt;/a&gt;&#xA;&#xA;        &#xA;         &#xA;        &lt;a&#xA;          href=&#34;https://www.instagram.com/gxb5443/&#34;&#xA;          target=&#34;_blank&#34;&#xA;          rel=&#34;noopener noreferrer&#34;&#xA;          aria-label=&#34;instagram&#34;&#xA;          &gt;&lt;i class=&#34;icon-instagram&#34;&gt;&lt;/i&gt;&#xA;        &lt;/a&gt;&#xA;&#xA;        &#xA;         &#xA;        &lt;a&#xA;          href=&#34;https://bsky.app/profile/gianbiondi.bsky.social&#34;&#xA;          target=&#34;_blank&#34;&#xA;          rel=&#34;noopener noreferrer&#34;&#xA;          aria-label=&#34;bluesky&#34;&#xA;          &gt;&lt;i class=&#34;icon-bluesky&#34;&gt;&lt;/i&gt;&#xA;        &lt;/a&gt;&#xA;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;&lt;/div&gt;&#xA;&#xA;&#xA;    &lt;/div&gt;&#xA;    &#xA;&#xA;    &lt;/div&gt;&#xA;&#xA;&#xA;    &lt;div class=&#34;row platform-links&#34;&gt;&#xA;      &lt;div class=&#34;col-12&#34;&gt;&lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;  &#xA;&lt;/section&gt;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&lt;section  id=&#34;about&#34; class=&#34;section rad-animation-group pb-0&#34;&gt;&#xA;  &lt;div class=&#34;rad-fade-down&#34;&gt;&#xA;    &lt;div class=&#34;row d-flex flex-column-reverse flex-md-row&#34;&gt;&#xA;      &lt;div class=&#34;about__profile-picture col-12 col-md-6&#34;&gt;&#xA;        &#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;&#xA;        &#xA;        &#xA;&#xA;&#xA;&#xA;    &#xA;    &#xA;&#xA;&#xA;    &lt;picture class=&#34;&#34;&gt;&#xA;            &#xA;            &#xA;&#xA;            &lt;source srcset=&#34;http://localhost:1313/images/gian-working-left_hu_368eb479ee54575a.webp 1x, http://localhost:1313/images/gian-working-left_hu_b764703f25cfe83d.webp 2x&#34; type=&#34;image/webp&#34; /&gt;&#xA;            &lt;source srcset=&#34;http://localhost:1313/images/gian-working-left_hu_960ac1ede3063825.jpg 1x, http://localhost:1313/images/gian-working-left_hu_517052a3c58092e5.jpg 2x&#34; type=&#34;image/jpeg&#34;&gt;&#xA;&#xA;        &lt;img&#xA;                width=&#34;392&#34;&#xA;                height=&#34;400&#34;&#xA;                class=&#34;lozad img-responsive image-left-overflow&#34;&#xA;                data-src=&#34;http://localhost:1313/images/gian-working-left_hu_960ac1ede3063825.jpg&#34;&#xA;                alt=&#39;&#39;&#xA;                src=&#34;data:image/gif;base64,R0lGODlhBwACAIAAAP///wAAACH5BAEAAAEALAAAAAAHAAIAAAIDjI9YADs=&#34;&#xA;                loading=&#34;lazy&#34;&#xA;                decoding=&#34;async&#34;&#xA;        /&gt;&#xA;    &lt;/picture&gt;&#xA;&#xA;      &lt;/div&gt;&#xA;      &lt;div class=&#34;col-12 col-md-6 my-auto&#34;&gt;&#xA;        &lt;h2&gt;Who am I?&lt;/h2&gt;&#xA;        &lt;div class=&#34;about-me content&#34;&gt;&#xA;          &lt;p&gt;I&#39;m easy going, curious, a fast-learner, and a natural leader. I do what I love and I love what I do. I lead by example and I love to work side-by-side with my teams.&lt;/p&gt;</description>
