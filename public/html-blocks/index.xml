    <item>
      <title></title>
      <link>http://localhost:1313/html-blocks/homelab-diagram/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/html-blocks/homelab-diagram/</guid>
      <description>&lt;!DOCTYPE html&gt;&#xA;&lt;html lang=&#34;en&#34;&gt;&#xA;&lt;head&gt;&#xA;&lt;meta charset=&#34;UTF-8&#34;&gt;&#xA;&lt;meta name=&#34;viewport&#34; content=&#34;width=device-width, initial-scale=1.0&#34;&gt;&#xA;&lt;title&gt;Homelab Network Diagram&lt;/title&gt;&#xA;&lt;style&gt;&#xA;  @import url(&#39;https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&amp;family=Syne:wght@400;600;700;800&amp;display=swap&#39;);&#xA;&#xA;  :root {&#xA;    --bg: #0d1117;&#xA;    --surface: #161b22;&#xA;    --surface2: #1c2333;&#xA;    --border: #30363d;&#xA;    --accent: #58a6ff;&#xA;    --accent2: #3fb950;&#xA;    --accent4: #d2a8ff;&#xA;    --text: #e6edf3;&#xA;    --text-muted: #8b949e;&#xA;    --wan: #f78166;&#xA;    --nfs: #ffa657;&#xA;    --planned: #d2a8ff;&#xA;  }&#xA;&#xA;  * { box-sizing: border-box; margin: 0; padding: 0; }&#xA;&#xA;  body {&#xA;    background: var(--bg);&#xA;    color: var(--text);&#xA;    font-family: &#39;JetBrains Mono&#39;, monospace;&#xA;    min-height: 100vh;&#xA;    padding: 32px 24px;&#xA;  }&#xA;&#xA;  h1 {&#xA;    font-family: &#39;Syne&#39;, sans-serif;&#xA;    font-weight: 800;&#xA;    font-size: 1.6rem;&#xA;    letter-spacing: -0.02em;&#xA;    color: var(--text);&#xA;    margin-bottom: 4px;&#xA;  }&#xA;&#xA;  .subtitle {&#xA;    font-size: 0.72rem;&#xA;    color: var(--text-muted);&#xA;    margin-bottom: 32px;&#xA;    letter-spacing: 0.05em;&#xA;    text-transform: uppercase;&#xA;  }&#xA;&#xA;  .wrap { max-width: 920px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 0; }&#xA;&#xA;  .layer-label {&#xA;    font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;&#xA;    color: var(--text-muted); margin-bottom: 8px;&#xA;    padding-left: 8px; border-left: 2px solid var(--border); width: 100%;&#xA;  }&#xA;&#xA;  .connector { width: 2px; margin: 0 auto; position: relative; }&#xA;  .connector.wan  { background: var(--wan); height: 32px; }&#xA;  .connector.main { background: var(--accent); height: 28px; }&#xA;  .connector-label {&#xA;    position: absolute; left: 8px; top: 50%; transform: translateY(-50%);&#xA;    font-size: 0.58rem; color: var(--text-muted); white-space: nowrap; letter-spacing: 0.06em;&#xA;  }&#xA;&#xA;  .bus-wrap { width: 100%; max-width: 900px; padding: 10px 0 6px; position: relative; }&#xA;  .bus {&#xA;    height: 3px;&#xA;    background: linear-gradient(90deg, transparent, var(--accent) 6%, var(--accent) 94%, transparent);&#xA;    position: relative;&#xA;  }&#xA;  .bus-label {&#xA;    position: absolute; top: -18px; left: 50%; transform: translateX(-50%);&#xA;    font-size: 0.6rem; color: var(--accent); letter-spacing: 0.08em;&#xA;    text-transform: uppercase; white-space: nowrap;&#xA;  }&#xA;&#xA;  .node {&#xA;    background: var(--surface); border: 1px solid var(--border);&#xA;    border-radius: 8px; padding: 12px 14px; min-width: 130px;&#xA;  }&#xA;  .node.planned { border-style: dashed; border-color: rgba(210,168,255,0.4); opacity: 0.85; }&#xA;  .node-icon  { font-size: 1.1rem; margin-bottom: 5px; display: block; }&#xA;  .node-name  { font-family: &#39;Syne&#39;, sans-serif; font-weight: 700; font-size: 0.8rem; color: var(--text); margin-bottom: 2px; }&#xA;  .node-sub   { font-size: 0.62rem; color: var(--text-muted); line-height: 1.5; }&#xA;  .node-badge {&#xA;    display: inline-block; font-size: 0.55rem; padding: 1px 6px;&#xA;    border-radius: 3px; margin-top: 5px; font-weight: 600;&#xA;    letter-spacing: 0.05em; text-transform: uppercase;&#xA;  }&#xA;  .badge-wan     { background: rgba(247,129,102,0.15); color: var(--wan);     border: 1px solid rgba(247,129,102,0.3); }&#xA;  .badge-nas     { background: rgba(255,166,87,0.12);  color: var(--nfs);     border: 1px solid rgba(255,166,87,0.3); }&#xA;  .badge-ap      { background: rgba(63,185,80,0.12);   color: var(--accent2); border: 1px solid rgba(63,185,80,0.3); }&#xA;  .badge-planned { background: rgba(210,168,255,0.12); color: var(--planned); border: 1px solid rgba(210,168,255,0.3); }&#xA;&#xA;  .bus-drops {&#xA;    display: flex; justify-content: space-around; align-items: flex-start;&#xA;    width: 100%; max-width: 900px; flex-wrap: wrap; gap: 8px;&#xA;  }&#xA;  .drop { display: flex; flex-direction: column; align-items: center; }&#xA;  .drop-line { width: 2px; height: 20px; }&#xA;  .drop-line.lan { background: var(--accent); }&#xA;&#xA;  .cluster-card {&#xA;    background: var(--surface); border: 1px solid var(--border);&#xA;    border-radius: 10px; padding: 14px; width: 100%; max-width: 900px;&#xA;  }&#xA;  .cluster-header { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }&#xA;  .cluster-title    { font-family: &#39;Syne&#39;, sans-serif; font-weight: 700; font-size: 0.85rem; color: var(--accent); }&#xA;  .cluster-subtitle { font-size: 0.6rem; color: var(--text-muted); margin-left: auto; }&#xA;  .cluster-nodes { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }&#xA;&#xA;  .pve-node { background: var(--surface2); border: 1px solid var(--border); border-radius: 7px; padding: 12px; }&#xA;  .pve-node-header {&#xA;    font-family: &#39;Syne&#39;, sans-serif; font-weight: 700; font-size: 0.75rem;&#xA;    color: var(--text); margin-bottom: 10px; display: flex; align-items: center; gap: 6px;&#xA;  }&#xA;  .pve-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent2); box-shadow: 0 0 6px var(--accent2); flex-shrink: 0; }&#xA;&#xA;  .vm-list { display: flex; flex-direction: column; gap: 4px; }&#xA;  .vm-item {&#xA;    display: flex; align-items: center; gap: 6px;&#xA;    font-size: 0.65rem; color: var(--text-muted);&#xA;    padding: 4px 6px; border-radius: 4px;&#xA;    background: rgba(255,255,255,0.02); border: 1px solid transparent;&#xA;  }&#xA;  .vm-item:hover { background: rgba(88,166,255,0.05); border-color: rgba(88,166,255,0.15); color: var(--text); }&#xA;  .vm-dot { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }&#xA;  .dot-coreos { background: var(--accent); }&#xA;  .dot-misc   { background: var(--text-muted); }&#xA;  .dot-opns   { background: var(--wan); }&#xA;  .dot-dns    { background: var(--accent2); }&#xA;&#xA;  .vm-tag {&#xA;    margin-left: auto; font-size: 0.5rem; padding: 1px 4px; border-radius: 2px;&#xA;    background: rgba(88,166,255,0.1); color: var(--accent);&#xA;    border: 1px solid rgba(88,166,255,0.2); white-space: nowrap;&#xA;  }&#xA;  .vm-tag.opns { background: rgba(247,129,102,0.1); color: var(--wan); border-color: rgba(247,129,102,0.2); }&#xA;  .vm-tag.dns  { background: rgba(63,185,80,0.1); color: var(--accent2); border-color: rgba(63,185,80,0.2); }&#xA;  .vm-tag.warn { background: rgba(247,129,102,0.08); color: var(--wan); border-color: rgba(247,129,102,0.15); font-style: italic; }&#xA;  .vm-tag.misc { background: rgba(139,148,158,0.1); color: var(--text-muted); border-color: rgba(139,148,158,0.2); }&#xA;&#xA;  /* Storage model */&#xA;  .section-label {&#xA;    font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;&#xA;    color: var(--text-muted); margin-bottom: 10px;&#xA;    padding-left: 8px; border-left: 2px solid var(--nfs); width: 100%;&#xA;  }&#xA;  .storage-row { display: flex; gap: 12px; flex-wrap: wrap; width: 100%; max-width: 900px; }&#xA;  .storage-card {&#xA;    background: var(--surface); border: 1px solid rgba(255,166,87,0.3);&#xA;    border-radius: 8px; padding: 12px 14px; flex: 1; min-width: 160px;&#xA;  }&#xA;  .storage-card.local { border-color: rgba(88,166,255,0.25); }&#xA;  .storage-card.backup { border-color: rgba(255,166,87,0.18); }&#xA;  .storage-card-title {&#xA;    font-family: &#39;Syne&#39;, sans-serif; font-weight: 700; font-size: 0.78rem;&#xA;    margin-bottom: 8px; display: flex; align-items: center; gap: 6px;&#xA;  }&#xA;  .storage-detail { font-size: 0.62rem; color: var(--text-muted); line-height: 1.6; }&#xA;  .storage-detail span { display: block; padding: 2px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }&#xA;  .storage-detail span:last-child { border: none; }&#xA;  .storage-hint { font-size: 0.6rem; color: var(--text-muted); margin-top: 8px; padding-left: 4px; width: 100%; max-width: 900px; }&#xA;&#xA;  /* Improvements */&#xA;  .improvements { display: flex; flex-direction: column; gap: 8px; width: 100%; max-width: 900px; }&#xA;  .imp-label {&#xA;    font-size: 0.6rem; letter-spacing: 0.12em; text-transform: uppercase;&#xA;    color: var(--text-muted); margin-bottom: 2px;&#xA;    padding-left: 8px; border-left: 2px solid var(--planned); width: 100%;&#xA;  }&#xA;  .imp-item {&#xA;    display: flex; align-items: flex-start; gap: 10px;&#xA;    padding: 8px 12px; background: var(--surface);&#xA;    border-radius: 6px; border: 1px dashed rgba(210,168,255,0.25);&#xA;    font-size: 0.65rem; color: var(--text-muted);&#xA;  }&#xA;  .imp-item strong { color: var(--planned); margin-right: 4px; }&#xA;  .imp-icon { font-size: 0.9rem; flex-shrink: 0; margin-top: 1px; }&#xA;&#xA;  /* Legend */&#xA;  .legend {&#xA;    display: flex; gap: 20px; flex-wrap: wrap;&#xA;    padding: 10px 14px; background: var(--surface);&#xA;    border: 1px solid var(--border); border-radius: 8px;&#xA;    width: 100%; max-width: 900px;&#xA;  }&#xA;  .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.62rem; color: var(--text-muted); }&#xA;  .legend-line { width: 24px; height: 2px; }&#xA;  .legend-dash { width: 24px; height: 0; border-top: 2px dashed; }&#xA;&#xA;  .gap { height: 24px; }&#xA;  .gap-sm { height: 16px; }&#xA;&lt;/style&gt;&#xA;&lt;/head&gt;&#xA;&lt;body&gt;&#xA;&lt;div class=&#34;wrap&#34; style=&#34;max-width:920px;margin:0 auto;&#34;&gt;&#xA;&#xA;  &lt;h1&gt;Homelab Network&lt;/h1&gt;&#xA;  &lt;p class=&#34;subtitle&#34;&gt;Current topology · 192.168.1.0/24 · Improvements noted&lt;/p&gt;</description>
    </item>
